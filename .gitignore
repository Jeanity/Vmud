node_modules/
dist/
*.tsbuildinfo
.env
.env.local

# Third-party world data and everything derived from it. Never commit; reproducible
# via `npm run worldgen`. See docs/RESEARCH-map-data.md.
data/zones-source/
data/world/*
# **Except the overrides.** They are the one thing under `data/` that no command can regenerate —
# hand-authored content — and a git-ignored directory is exactly where that gets lost to a fresh
# clone. See `server/src/overrides.ts`.
!data/world/overrides/
# **But not the operator switches.** `settings.json` sits in the overrides directory because nothing
# regenerates it either, but it is *deployment state* rather than content: whether player killing is on
# is a decision one operator made on one server for one evening, and committing it would push that
# decision to every clone. The default is in `settings.ts` and a missing file reads as it.
data/world/overrides/settings.json
# The noticeboards' posts: runtime state the gods write from the panel, `settings.json`'s argument.
data/world/overrides/boards.json

# Per-character save data (explored maps, inventories, worn kit).
data/players/

# Accounts: who may connect and which characters are theirs. Runtime state like the players
# beside it, and a password hash is exactly the file the design note says must never be
# committed. See docs/DESIGN-accounts.md §4.
data/accounts/

# The admin API's audit trail. Runtime history, not content.
data/admin-audit.jsonl

# Art assets are large and fetched from upstream; keep LICENSE files only.
assets/**
!assets/**/LICENSE
!assets/**/*.md

# Generated 3D model artefacts: baked by worldgen (treegen's conifers, modelgen's Quaternius kit)
# into the client's public dir. Reproducible like data/world — a fresh checkout or worktree
# regenerates both, byte-identically per run:
#   node --disable-warning=ExperimentalWarning packages/worldgen/src/treegen.ts
#   node --disable-warning=ExperimentalWarning packages/worldgen/src/modelgen.ts --source D:/MyGame/assets/quaternius/nature
# The kit's source lives under the git-ignored assets/, so a worktree must point --source (or
# GAME_NATURE_KIT) at the main checkout. assets.test.ts and kit.test.ts skip cleanly when absent.
packages/client3d/public/models/

logs/
*.log
.DS_Store
Thumbs.db
