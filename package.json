{
  "name": "mygame",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "A graphical multiplayer RPG built on the world of TorilMUD",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client,admin -c cyan,magenta,yellow \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:server": "npm run dev --workspace @mygame/server",
    "dev:client": "npm run dev --workspace @mygame/client",
    "dev:admin": "npm run dev --workspace @mygame/admin",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "worldgen": "node --disable-warning=ExperimentalWarning packages/worldgen/src/index.ts",
    "artgen": "node --disable-warning=ExperimentalWarning packages/worldgen/src/artgen.ts",
    "artassign": "node --disable-warning=ExperimentalWarning packages/worldgen/src/artassign.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22"
  }
}
